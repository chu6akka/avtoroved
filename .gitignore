# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Виртуальные окружения ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Модели (скачиваются автоматически, сотни МБ) ──────────────────────────────
avtoroved-main/models/
avtoroved-main/stanza_resources/

# ── Пользовательские базы данных (создаются при первом запуске) ───────────────
avtoroved-main/corpus.db
avtoroved-main/query_history.db
avtoroved-main/protocol.db
*.db-journal
*.db-wal
*.db-shm
.avtoroved/

# ── Пользовательский конфиг ───────────────────────────────────────────────────
avtoroved-main/config.json

# ── Кэш ──────────────────────────────────────────────────────────────────────
avtoroved-main/.cache/
.cache/

# ── IDE / редакторы ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Claude Code ───────────────────────────────────────────────────────────────
# Хук запуска и общие настройки версионируются: без них удалённая сессия
# не может собрать тесты. Личные настройки разработчика остаются вне Git.
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json

# ── ОС ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Логи и временные файлы ────────────────────────────────────────────────────
*.log
*.tmp

# Бэкапы словарных баз (создаются при обновлении)
*.bak-*

# Pilot 01 corpus is generated locally and may contain private source mappings
avtoroved-main/artifacts/pilot01_corpus/
avtoroved-main/artifacts/controlled_own/
