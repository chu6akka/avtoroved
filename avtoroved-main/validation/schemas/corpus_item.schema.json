{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Avtoroved validation corpus item",
  "type": "object",
  "required": ["document_id", "author_id_pseudonymous", "sample_type", "genre", "source_type", "creation_context", "year_or_period", "word_count", "character_count", "known_author", "disputed_or_reference", "pair_group_id", "notes", "subset", "text_path", "input_sha256"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "author_id_pseudonymous": {"type": "string", "pattern": "^[A-Z][0-9]{3,}$"},
    "sample_type": {"enum": ["CONTROL", "DISPUTED", "REFERENCE"]},
    "genre": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "creation_context": {"type": "string", "minLength": 1},
    "year_or_period": {"type": ["string", "integer"]},
    "region_optional": {"type": ["string", "null"]},
    "word_count": {"type": "integer", "minimum": 0},
    "character_count": {"type": "integer", "minimum": 0},
    "known_author": {"type": "boolean"},
    "disputed_or_reference": {"enum": ["DISPUTED", "REFERENCE", "CONTROL"]},
    "pair_group_id": {"type": ["string", "null"]},
    "notes": {"type": "string"},
    "subset": {"enum": ["DEVELOPMENT", "PILOT", "VALIDATION"]},
    "text_path": {"type": "string"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
